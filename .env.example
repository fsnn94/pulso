# ----- Backend -----
DATABASE_URL=postgresql+asyncpg://pulso:pulso@db:5432/pulso
JWT_SECRET=change-me-to-something-long-and-random
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Seeded admin (changeable in app/config.py)
ADMIN_EMAIL=admin@pulso.local
ADMIN_PASSWORD=admin123

# ----- LLM resolver (optional) -----
# Set to enable the llm_search resolver. When empty, llm-flagged markets
# stay in the admin queue with a manual-review prompt.
LLM_RESOLVER_API_KEY=
LLM_RESOLVER_BASE_URL=https://api.anthropic.com/v1/messages

# ----- Frontend -----
NEXT_PUBLIC_API_BASE=http://localhost:8000
